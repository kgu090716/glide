<Window
    x:Class="ThreeFingerWindowDrag.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="20,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B0;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Glide" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Localize('Tagline')}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" SizeChanged="SettingsSizeChanged">
            <Grid x:Name="SettingsPage" MaxWidth="1000" Padding="28,14,28,24" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Localize('PageTitle')}" Style="{StaticResource TitleTextBlockStyle}" FontSize="28" />
                            <TextBlock Text="{x:Bind Localize('PageDescription')}" Style="{StaticResource MutedText}" FontSize="13" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="52" Height="52" Margin="16,0,0,0">
                            <FontIcon Glyph="&#xE8B0;" FontSize="25" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SettingsCard}" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StateTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="StateDescription" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" OnContent="{x:Bind Localize('Enabled')}" OffContent="{x:Bind Localize('Paused')}" VerticalAlignment="Center" Toggled="EnabledChanged" AutomationProperties.Name="{x:Bind Localize('EnableDragging')}" />
                        </Grid>
                    </Border>

                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational" />
                    <InfoBar x:Name="ElevationNotice" IsOpen="False" IsClosable="True" Severity="Warning" Title="{x:Bind Localize('ElevationNeeded')}" Message="{x:Bind Localize('ElevationHelp')}">
                        <InfoBar.ActionButton><Button x:Name="ElevationNoticeButton" Content="{x:Bind Localize('RestartAsAdministrator')}" Click="RestartElevatedClicked" /></InfoBar.ActionButton>
                    </InfoBar>

                    <Border Style="{StaticResource SettingsCard}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind Localize('Language')}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Localize('LanguageDescription')}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Bind Localize('Language')}" SelectionChanged="LanguageChanged">
                                <ComboBoxItem Content="{x:Bind Localize('WindowsLanguage')}" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="한국어" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Localize('DragSettings')}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('FollowCursor')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('FollowCursorHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="FollowSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="FollowChanged" AutomationProperties.Name="{x:Bind Localize('FollowCursor')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('RaiseWindow')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('RaiseWindowHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RaiseSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="RaiseChanged" AutomationProperties.Name="{x:Bind Localize('RaiseWindow')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('TopOverflow')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('TopOverflowHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OverflowSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="OverflowChanged" AutomationProperties.Name="{x:Bind Localize('TopOverflow')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('PinchResize')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('PinchResizeHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PinchSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="PinchChanged" AutomationProperties.Name="{x:Bind Localize('PinchResize')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Localize('DragSpeed')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Localize('DragSpeedHelp')}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                        <TextBlock x:Name="SpeedValue" Text="12 px/mm" FontWeight="SemiBold" FontSize="13" />
                                    </Border>
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="3" Maximum="36" StepFrequency="1" TickFrequency="3" TickPlacement="None" Value="12" ValueChanged="SpeedChanged" AutomationProperties.Name="{x:Bind Localize('DragSpeedName')}" />
                                <Grid Margin="0,-8,0,0"><TextBlock Text="{x:Bind Localize('Slower')}" Style="{StaticResource MutedText}" /><TextBlock Text="{x:Bind Localize('Faster')}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('RestoreMaximized')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('RestoreMaximizedHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RestoreSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="RestoreChanged" AutomationProperties.Name="{x:Bind Localize('RestoreMaximizedName')}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DirectionalOptions" Spacing="10">
                        <TextBlock Text="{x:Bind Localize('DirectionalResize')}" FontSize="16" FontWeight="SemiBold" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Localize('ResizeEdges')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Localize('ResizeEdgesHelp')}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DirectionalSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="DirectionalChanged" AutomationProperties.Name="{x:Bind Localize('ResizeEdges')}" />
                                </Grid>
                                <StackPanel x:Name="DirectionalSettings" Spacing="14">
                                    <NumberBox x:Name="ResizeHoldBox" Header="{x:Bind Localize('HoldTime')}" SpinButtonPlacementMode="Inline" ValueChanged="ResizeHoldChanged" AutomationProperties.Name="{x:Bind Localize('HoldTimeName')}" />
                                    <ComboBox x:Name="ResizeBehaviorCombo" Header="{x:Bind Localize('ResizeMode')}" HorizontalAlignment="Stretch" SelectionChanged="ResizeBehaviorChanged" AutomationProperties.Name="{x:Bind Localize('ResizeModeName')}">
                                        <ComboBoxItem Content="{x:Bind Localize('GrowInDirection')}" />
                                        <ComboBoxItem Content="{x:Bind Localize('LowerCorners')}" />
                                    </ComboBox>
                                    <TextBlock x:Name="ResizeBehaviorDescription" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LayoutOptions" Spacing="10">
                        <TextBlock Text="{x:Bind Localize('Layout')}" FontSize="16" FontWeight="SemiBold" />
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('MaximizeAtTop')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('MaximizeAtTopHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TopEdgeSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="TopEdgeChanged" AutomationProperties.Name="{x:Bind Localize('MaximizeAtTop')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('SideSnap')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('SideSnapHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SideSnapSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="SideSnapChanged" AutomationProperties.Name="{x:Bind Localize('SideSnap')}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Localize('Flick')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Localize('FlickHelp')}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FlickSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="FlickChanged" AutomationProperties.Name="{x:Bind Localize('Flick')}" />
                                </Grid>
                                <StackPanel x:Name="FlickSensitivityPanel" Spacing="8">
                                    <Grid><TextBlock Text="{x:Bind Localize('FlickSensitivity')}" FontSize="13" /><TextBlock x:Name="FlickSensitivityValue" Text="5 / 10" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" /></Grid>
                                    <Slider x:Name="FlickSensitivitySlider" Minimum="1" Maximum="10" StepFrequency="1" Value="5" ValueChanged="FlickSensitivityChanged" AutomationProperties.Name="{x:Bind Localize('FlickSensitivity')}" />
                                    <Grid Margin="0,-8,0,0"><TextBlock Text="{x:Bind Localize('FirmFlick')}" Style="{StaticResource MutedText}" /><TextBlock Text="{x:Bind Localize('GentleFlick')}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Localize('Convenience')}" FontSize="16" FontWeight="SemiBold" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind Localize('AdministratorWindows')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="AdministratorStatus" Style="{StaticResource MutedText}" />
                                <Button x:Name="RestartElevatedButton" Click="RestartElevatedClicked" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA18;" FontSize="14" /><TextBlock Text="{x:Bind Localize('RestartAsAdministrator')}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Localize('StartAtSignIn')}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Localize('StartAtSignInHelp')}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="{x:Bind Localize('On')}" OffContent="{x:Bind Localize('Off')}" VerticalAlignment="Center" Toggled="StartupChanged" AutomationProperties.Name="{x:Bind Localize('StartAtSignIn')}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="{x:Bind Localize('Touchpad')}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="RefreshClicked" Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="{x:Bind Localize('ScanAgain')}" /></StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" VerticalAlignment="Center"><FontIcon Glyph="&#xEDA4;" FontSize="23" /></Border>
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeviceTitle" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="DeviceDetail" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Localize('FingerCountTip')}">
                                    <Ellipse x:Name="Finger1" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.24" />
                                    <Ellipse x:Name="Finger2" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.24" />
                                    <Ellipse x:Name="Finger3" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.24" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,2,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Localize('ShortcutHint')}" Style="{StaticResource MutedText}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="HideClicked" Content="{x:Bind Localize('HideToTray')}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,-8,0,0">
                        <HyperlinkButton Click="DiagnosticClicked" Content="{x:Bind Localize('SaveDiagnostics')}" Padding="0,4" />
                        <TextBlock Text="·" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
